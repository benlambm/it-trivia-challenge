# Backend secrets. Copy this file to .env and fill in the values.
# NEVER commit .env — it's in .gitignore for a reason.
#
# Rotate by editing the live /opt/trivia-app/api/.env and running:
#   systemctl restart trivia-api

GOOGLE_GENAI_API_KEY=

# Gemini model to generate with. Optional — defaults to googleai/gemini-3.7-flash.
# To switch models, change this line and `systemctl restart trivia-api`. No redeploy.
#
# 3.7-flash was pinned off from 2026-08-17 to 2026-09-01 while Google returned
# 503 "high demand" on nearly every 25-question generation; gemini-3.6-flash
# is the known-good fallback if that ever comes back.
TRIVIA_MODEL=googleai/gemini-3.7-flash

# Retry tuning. The whole request must finish inside nginx's proxy_read_timeout
# (180s for /api/ on trivia.benlamb.net), so we stop starting new attempts once
# the budget is spent. Keep the budget ~60s below the nginx timeout so a slow
# final attempt still lands inside it.
# TRIVIA_RETRY_BUDGET_MS=120000
# TRIVIA_MIN_ATTEMPT_MS=18000
