# Backend secrets. Copy this file to .env and fill in the values.
# NEVER commit .env — it's in .gitignore for a reason.
#
# Rotate by editing the live /opt/trivia-app/api/.env and running:
#   systemctl restart trivia-api

GOOGLE_GENAI_API_KEY=

# Gemini model to generate with. Optional — defaults to googleai/gemini-3.8-flash.
# To switch models, change this line and `systemctl restart trivia-api`. No redeploy.
#
# gemini-3.7-flash was deprecated by Google on 2026-10-09 and now redirects to
# 3.8-flash, so name 3.8-flash directly. gemini-3.6-flash is the known-good
# fallback if 3.8-flash starts returning 503 "high demand".
TRIVIA_MODEL=googleai/gemini-3.8-flash

# Retry tuning. The whole request must finish inside nginx's proxy_read_timeout
# (180s for /api/ on trivia.benlamb.net), so we stop starting new attempts once
# the budget is spent. Keep the budget ~60s below the nginx timeout so a slow
# final attempt still lands inside it.
# TRIVIA_RETRY_BUDGET_MS=120000
# TRIVIA_MIN_ATTEMPT_MS=18000

# Usage/cost events file. Production leaves this unset: the systemd drop-in
# (ops/systemd/trivia-api.service.d/20-state.conf) sets STATE_DIRECTORY and
# events go to /var/lib/trivia-api/events.jsonl. Local runs default to api/data/.
# TRIVIA_EVENTS_FILE=
# Port (default 3000), e.g. to run a second copy for testing.
# TRIVIA_PORT=3000
