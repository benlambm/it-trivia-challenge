# Backend secrets. Copy this file to .env and fill in the values.
# NEVER commit .env — it's in .gitignore for a reason.
#
# Rotate by editing the live /opt/trivia-app/api/.env and running:
#   systemctl restart trivia-api

GOOGLE_GENAI_API_KEY=

# Gemini model to generate with. Optional — defaults to googleai/gemini-3.6-flash.
# To switch models, change this line and `systemctl restart trivia-api`. No redeploy.
#
# Pinned to 3.6-flash on 2026-08-17 because gemini-3.7-flash (preferred) and
# gemini-flash-latest were both returning 503 "high demand" on 100% of
# 25-question generations. Flip to googleai/gemini-3.7-flash once that clears.
TRIVIA_MODEL=googleai/gemini-3.6-flash

# Retry tuning. The whole request must finish inside nginx's proxy_read_timeout
# (60s), so we stop starting new attempts once the budget is nearly spent.
# TRIVIA_RETRY_BUDGET_MS=55000
# TRIVIA_MIN_ATTEMPT_MS=18000
